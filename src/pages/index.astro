---
// The landing: an index, not a menu. Two ruled rows.
// /tech stays the canonical portfolio URL, so resume links never land here.
import Mark from '../components/Mark.astro';
import { FAVICON_LIFE } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanishk Sigar</title>
  <meta name="description" content="Kanishk Sigar — the things I build, and the things I think about." />
  <link rel="canonical" href="https://kanishksigar.me/" />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#12140F" />

  <link rel="icon" href={FAVICON_LIFE} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kanishk Sigar" />
  <meta property="og:title" content="Kanishk Sigar" />
  <meta property="og:description" content="The things I build, and the things I think about." />
  <meta property="og:url" content="https://kanishksigar.me/" />
  <meta property="og:image" content="https://kanishksigar.me/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;1,300&family=Plus+Jakarta+Sans:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <main class="gate">

    <header class="gate-head">
      <Mark size={22} class="gate-mark" />
      <span class="gate-name">Kanishk Sigar</span>
    </header>

    <nav class="index" aria-label="Sections">
      <a href="/tech" class="row">
        <span class="row-word">tech</span>
        <span class="row-note">projects, experience, resume</span>
      </a>
      <a href="/life" class="row">
        <span class="row-word">life</span>
        <span class="row-note">writing, books, everything else</span>
      </a>
    </nav>

    <footer class="gate-foot">
      <a href="https://github.com/KanishkSigar" target="_blank" rel="noopener">github</a>
      <a href="https://www.linkedin.com/in/kanishk-sigar" target="_blank" rel="noopener">linkedin</a>
      <a href="mailto:kanishksigar@gmail.com">email</a>
    </footer>

  </main>

</body>
</html>

<style is:global>
  :root {
    --ground: #12140F;
    --ink: #E4E3DA;
    --ink-2: #9C9E92;
    --ink-3: #6C6F63;
    --rule: #2A2E25;
    --accent: #8AA36F;
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--ground);
    color: var(--ink);
    font-family: 'Spectral', Georgia, serif;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }

  .gate {
    width: 100%;
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: 46px;
  }

  /* --- head --- */
  .gate-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gate-mark { color: var(--accent); display: block; }

  .gate-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* --- the index --- */
  .index { display: flex; flex-direction: column; }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 26px 4px;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    transition: padding-left .25s ease, border-color .25s ease;
  }

  .row:last-child { border-bottom: 1px solid var(--rule); }

  .row-word {
    font-size: 34px;
    line-height: 1;
    transition: color .25s ease;
  }

  .row-note {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 13.5px;
    color: var(--ink-3);
    text-align: right;
    transition: color .25s ease;
  }

  .row:hover,
  .row:focus-visible {
    padding-left: 14px;
    border-color: var(--accent);
  }

  .row:hover .row-word,
  .row:focus-visible .row-word { color: var(--accent); }

  .row:hover .row-note,
  .row:focus-visible .row-note { color: var(--ink-2); }

  /* --- foot --- */
  .gate-foot {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }

  .gate-foot a {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 13px;
    color: var(--ink-3);
    text-decoration: none;
    transition: color .2s ease;
  }

  .gate-foot a:hover { color: var(--ink); }

  @media (max-width: 560px) {
    .gate { gap: 36px; }
    .row { flex-direction: column; align-items: flex-start; gap: 6px; padding: 22px 4px; }
    .row-word { font-size: 29px; }
    .row-note { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .row, .row-word, .row-note { transition: none; }
    .row:hover { padding-left: 4px; }
  }
</style>
