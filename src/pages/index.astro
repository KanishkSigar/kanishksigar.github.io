---
// The landing page. Two doors, nothing else.
// /tech stays the canonical portfolio URL, so resume links never land here.
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanishk Sigar</title>
  <meta name="description" content="Kanishk Sigar — the things I build, and the things I think about." />
  <link rel="canonical" href="https://kanishksigar.me/" />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#0B1B3B" />

  <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2036%2036'%3E%3Cpath%20d='M18%202%20L20.5%2015.5%20L34%2018%20L20.5%2020.5%20L18%2034%20L15.5%2020.5%20L2%2018%20L15.5%2015.5%20Z'%20fill='%232563EB'/%3E%3C/svg%3E" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kanishk Sigar" />
  <meta property="og:title" content="Kanishk Sigar" />
  <meta property="og:description" content="The things I build, and the things I think about." />
  <meta property="og:url" content="https://kanishksigar.me/" />
  <meta property="og:image" content="https://kanishksigar.me/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>

  <main class="gate">

    <header class="gate-head">
      <svg class="gate-mark" viewBox="0 0 36 36" aria-hidden="true">
        <path d="M18 2 L20.5 15.5 L34 18 L20.5 20.5 L18 34 L15.5 20.5 L2 18 L15.5 15.5 Z" fill="#2563EB"/>
      </svg>
      <h1 class="gate-name">Kanishk Sigar</h1>
    </header>

    <nav class="doors" aria-label="Choose a section">
      <a href="/tech" class="door door--tech">
        <span class="door-label">tech</span>
        <span class="door-desc">the things I build</span>
      </a>
      <a href="/life" class="door door--life">
        <span class="door-label">life</span>
        <span class="door-desc">the things I think about</span>
      </a>
    </nav>

    <footer class="gate-foot">
      <a href="https://github.com/KanishkSigar" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/kanishk-sigar" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:kanishksigar@gmail.com">Email</a>
    </footer>

  </main>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: #0B1B3B;
    color: #E8ECF5;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
  }

  .gate {
    width: 100%;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 52px;
  }

  .gate-head { text-align: center; }

  .gate-mark {
    width: 28px;
    height: 28px;
    margin-bottom: 20px;
  }

  .gate-name {
    margin: 0;
    font-size: clamp(28px, 5vw, 38px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .door {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 30px 28px;
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color .2s ease, background .2s ease;
  }

  .door--tech { --accent: #2563EB; }
  .door--life { --accent: #C9A227; }

  .door:hover,
  .door:focus-visible {
    border-color: var(--accent);
    background: rgba(255,255,255,0.03);
  }

  .door-label {
    font-size: 21px;
    font-weight: 600;
    color: var(--accent);
  }

  .door-desc {
    font-size: 15px;
    line-height: 1.5;
    color: #93A3C2;
  }

  .gate-foot {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .gate-foot a {
    font-size: 13.5px;
    color: #6E7E9C;
    text-decoration: none;
    transition: color .2s ease;
  }

  .gate-foot a:hover { color: #E8ECF5; }

  @media (max-width: 640px) {
    .gate { gap: 40px; }
    .doors { grid-template-columns: 1fr; }
  }
</style>
