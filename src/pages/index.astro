---
// The landing page. Two doors, nothing else.
// /tech stays the canonical portfolio URL, so resume links never land here.
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanishk Sigar</title>
  <meta name="description" content="Kanishk Sigar — two sides. The things I build, and the things I think about." />
  <link rel="canonical" href="https://kanishksigar.me/" />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#0B1B3B" />

  <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2036%2036'%3E%3Cpath%20d='M18%202%20L20.5%2015.5%20L34%2018%20L20.5%2020.5%20L18%2034%20L15.5%2020.5%20L2%2018%20L15.5%2015.5%20Z'%20fill='%232563EB'/%3E%3C/svg%3E" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kanishk Sigar" />
  <meta property="og:title" content="Kanishk Sigar" />
  <meta property="og:description" content="Two sides. The things I build, and the things I think about." />
  <meta property="og:url" content="https://kanishksigar.me/" />
  <meta property="og:image" content="https://kanishksigar.me/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Spectral:ital,wght@0,300;0,400;1,400&display=swap" rel="stylesheet" />
</head>
<body>

  <main class="gate">

    <header class="gate-head">
      <svg class="gate-mark" viewBox="0 0 36 36" aria-hidden="true">
        <path d="M18 2 L20.5 15.5 L34 18 L20.5 20.5 L18 34 L15.5 20.5 L2 18 L15.5 15.5 Z" fill="#2563EB"/>
      </svg>
      <h1 class="gate-name">Kanishk Sigar</h1>
      <p class="gate-sub">two sides, one person. pick a door.</p>
    </header>

    <nav class="doors" aria-label="Choose a section">

      <a href="/tech" class="door door--tech">
        <span class="door-label">tech</span>
        <span class="door-title">the things I build</span>
        <p class="door-desc">
          Full-stack work, security research, a compiler, and whatever else is
          currently open in the editor.
        </p>
        <span class="door-meta">projects · experience · resume</span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>

      <a href="/life" class="door door--life">
        <span class="door-label">life</span>
        <span class="door-title">the things I think about</span>
        <p class="door-desc">
          Writing, the books I keep going back to, the ones I haven't read yet,
          and everything that isn't a project.
        </p>
        <span class="door-meta">writing · shelf · watching</span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>

    </nav>

    <footer class="gate-foot">
      <a href="https://github.com/KanishkSigar" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/kanishk-sigar" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://kanishksigar.substack.com" target="_blank" rel="noopener">Substack</a>
      <a href="mailto:kanishksigar@gmail.com">Email</a>
    </footer>

  </main>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: #0B1B3B;
    color: #E8ECF5;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
  }

  .gate {
    width: 100%;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* ---- head ---- */
  .gate-head { text-align: center; }

  .gate-mark {
    width: 30px;
    height: 30px;
    margin-bottom: 22px;
  }

  .gate-name {
    margin: 0;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .gate-sub {
    margin: 12px 0 0;
    font-family: 'Spectral', Georgia, serif;
    font-style: italic;
    font-size: 17px;
    color: #8FA0C0;
  }

  /* ---- doors ---- */
  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 34px 32px 30px;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 16px;
    background: rgba(255,255,255,0.02);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color .25s ease, background .25s ease, transform .25s ease;
  }

  .door::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .35s ease;
  }

  .door--tech { --accent: #2563EB; }
  .door--life { --accent: #C9A227; }

  .door:hover,
  .door:focus-visible {
    border-color: rgba(255,255,255,0.22);
    background: rgba(255,255,255,0.045);
    transform: translateY(-3px);
  }

  .door:hover::before,
  .door:focus-visible::before { transform: scaleX(1); }

  .door-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .door-title {
    margin-top: 14px;
    font-family: 'Spectral', Georgia, serif;
    font-size: 25px;
    font-weight: 400;
    line-height: 1.25;
  }

  .door-desc {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.65;
    color: #93A3C2;
  }

  .door-meta {
    margin-top: 26px;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: #5E6E8C;
  }

  .door-arrow {
    position: absolute;
    right: 30px;
    bottom: 26px;
    font-size: 18px;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity .25s ease, transform .25s ease;
  }

  .door:hover .door-arrow,
  .door:focus-visible .door-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---- foot ---- */
  .gate-foot {
    display: flex;
    justify-content: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .gate-foot a {
    font-size: 13.5px;
    color: #6E7E9C;
    text-decoration: none;
    transition: color .2s ease;
  }

  .gate-foot a:hover { color: #E8ECF5; }

  @media (max-width: 720px) {
    .gate { gap: 40px; }
    .doors { grid-template-columns: 1fr; }
    .door { padding: 28px 24px 26px; }
    .door-arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .door, .door::before, .door-arrow { transition: none; }
    .door:hover { transform: none; }
  }
</style>
