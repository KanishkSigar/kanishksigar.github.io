---
import Life from '../../layouts/Life.astro';
import { read, unread, readMore, unreadMore } from '../../data/shelf';

const groups = [
  { id: 'read', title: 'Read', books: read, more: readMore },
  { id: 'unread', title: 'To read', books: unread, more: unreadMore },
].filter(group => group.books.length > 0);
---

<Life title="Kanishk Sigar | The Shelf" description="What I've read, and what I haven't.">
  <header class="life-page-head">
    <h1>The shelf.</h1>
    <p class="life-deck">the list outgrows the shelf.</p>
    <nav class="shelf-nav" aria-label="Shelf sections">
      {groups.map(group => <a class="life-text-link" href={`#${group.id}`}>{group.title}</a>)}
    </nav>
  </header>

  {groups.map(group => (
    <section class="shelf-section" id={group.id} aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`}>{group.title}</h2>
      <ul class="shelf-list">
        {group.books.map(book => (
          <li>
            <h3>{book.title}</h3>
            <p class="reading-author">{book.author}</p>
            {book.note && <p class="reading-note">{book.note}</p>}
          </li>
        ))}
      </ul>
      {group.more && <p class="shelf-more">{group.more}</p>}
    </section>
  ))}
</Life>
