---
import Life from '../../layouts/Life.astro';
import { read, unread, readMore, unreadMore } from '../../data/shelf';
---

<Life title="Kanishk Sigar Shelf" description="What I've read, and what I haven't.">

  <p>the shelf.</p>

  <p class="shelf-lead">the list outgrows the shelf.</p>

  <section class="shelf">
    <h2>read</h2>
    <ul>
      {read.map((b) => (
        <li>
          <span class="b-title">{b.title}</span>
          <span class="b-author">{b.author}</span>
          {b.note && <span class="b-note">{b.note}</span>}
        </li>
      ))}
    </ul>
    <p class="shelf-more">{readMore}</p>
  </section>

  <section class="shelf">
    <h2>unread</h2>
    {unread.length === 0 ? (
      <p class="pending">still compiling. it only gets longer.</p>
    ) : (
      <ul>
        {unread.map((b) => (
          <li>
            <span class="b-title">{b.title}</span>
            <span class="b-author">{b.author}</span>
            {b.note && <span class="b-note">{b.note}</span>}
          </li>
        ))}
      </ul>
    )}
    {unread.length > 0 && <p class="shelf-more">{unreadMore}</p>}
  </section>

  <a href="/life" class="back">← life</a>

</Life>

<style>
  .shelf-lead { color: var(--ink-soft); margin-top: -0.8em; }

  .shelf { margin-top: 44px; }

  .shelf h2 {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 6px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }

  .shelf ul { list-style: none; margin: 0; padding: 0; }

  .shelf li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }

  .b-title { font-size: 20px; }
  .b-author { font-size: 15px; color: var(--ink-soft); }
  .b-note {
    margin-top: 6px;
    font-size: 15px;
    font-style: italic;
    color: var(--ink-faint);
    line-height: 1.5;
  }

  .pending {
    margin-top: 18px;
    font-style: italic;
    color: var(--ink-faint);
  }

  .shelf-more {
    margin: 16px 0 0;
    font-style: italic;
    color: var(--ink-faint);
  }

  .back {
    display: inline-block;
    margin-top: 52px;
    font-size: 15px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }
</style>
