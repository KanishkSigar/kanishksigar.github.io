---
import Life from '../../layouts/Life.astro';
import { getCollection } from 'astro:content';

const latest = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 5);
---

<Life title="Kanishk Sigar | Life" description="Notes, essays, marginalia, and a bookshelf.">
  <header class="life-intro">
    <h1>Writing &amp; books.</h1>
    <p class="life-deck">notes, essays, and what books leave behind.</p>
  </header>

  {latest.length > 0 && (
    <section class="life-section" aria-labelledby="recent-title">
      <h2 id="recent-title">Recent writing</h2>
      <ul class="life-entries">
        {latest.map(piece => (
          <li>
            <a href={`/life/writing/${piece.id}/`}>
              <span class="life-label entry-kind">{piece.data.form}</span>
              <strong>{piece.data.title}</strong>
              {piece.data.excerpt && <span class="entry-excerpt">{piece.data.excerpt}</span>}
            </a>
          </li>
        ))}
      </ul>
      <a class="life-text-link journal-archive" href="/life/writing/">Full writing archive</a>
    </section>
  )}
  <section class="journal-shelf" aria-labelledby="journal-shelf-title">
    <h2 id="journal-shelf-title">The shelf</h2>
    <p>
      mostly the same few writers. i don't have an unusual library, i just spend
      a long time in it. some of it has nothing to do with books at all.
    </p>
    <a class="life-text-link" href="/life/shelf/">Browse the shelf</a>
  </section>
</Life>
