---
import { getCollection, render } from 'astro:content';
import Life from '../../../layouts/Life.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('writing', ({ data }) => !data.draft);
  return pieces.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Life title={entry.data.title} description={entry.data.excerpt}>

  <article>
    <header class="piece-head">
      <h1>{entry.data.title}</h1>
      <p class="piece-meta">
        <span class="pm-form">{entry.data.form}</span>
        {entry.data.book && <span>· {entry.data.book}</span>}
      </p>
    </header>

    <div class="piece-body">
      <Content />
    </div>
  </article>

  <a href="/life/writing" class="back">← writing</a>

</Life>

<style>
  .piece-head { margin-bottom: 40px; }

  .piece-head h1 {
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .piece-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    font-size: 13.5px;
    color: var(--ink-faint);
  }
  .pm-form { text-transform: uppercase; letter-spacing: 0.1em; font-size: 11.5px; }

  .piece-body :global(p) { margin: 0 0 1.4em; }

  .back {
    display: inline-block;
    margin-top: 56px;
    font-size: 15px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }
</style>
