---
import { getCollection, render } from 'astro:content';
import Life from '../../../layouts/Life.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('writing', ({ data }) => !data.draft);
  return pieces.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Life title={entry.data.title} description={entry.data.excerpt} reading>

  <a href="/life/writing/" class="reading-back">← writing</a>

  <article>
    <header class="piece-head">
      <h1>{entry.data.title}</h1>
      <p class="piece-meta">
        <span class="pm-form">{entry.data.form}</span>
        {entry.data.book && <span>· {entry.data.book}</span>}
      </p>
    </header>

    <div class="piece-body">
      <Content />
    </div>
  </article>

  <a href="/life/writing" class="back">← writing</a>

</Life>

<style>
  .reading-back, .back { display: inline-block; color: var(--accent); font: 600 .86rem system-ui, sans-serif; }
  .reading-back { margin-bottom: 24px; }
  .piece-head { border-bottom: 1px solid var(--rule); margin-bottom: 32px; padding-bottom: 24px; }
  .piece-meta { display: flex; flex-wrap: wrap; gap: 4px 10px; margin: 12px 0 0; font-size: .9rem; color: var(--ink-soft); }
  .pm-form { color: var(--accent); }
  .piece-body { font-size: clamp(1.13rem, 2.25vw, 1.29rem); line-height: 1.83; overflow-wrap: anywhere; }
  .piece-body :global(p) { margin: 0 0 1.4em; }
  .piece-body :global(blockquote) { border-left: 1px solid var(--accent); margin-inline: 0; padding-left: 1.1em; color: var(--ink-soft); }
  .back { margin-top: 24px; }
</style>
