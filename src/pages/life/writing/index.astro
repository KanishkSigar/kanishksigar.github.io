---
import { getCollection } from 'astro:content';
import Life from '../../../layouts/Life.astro';

const pieces = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<Life title="Kanishk Sigar Writing" description="Notes, essays, and marginalia.">

  <p>writing.</p>

  <ul class="index">
    {pieces.map((p) => (
      <li>
        <a href={`/life/writing/${p.id}`}>
          <span class="i-title">{p.data.title}</span>
          <span class="i-form">{p.data.form}</span>
        </a>
      </li>
    ))}
  </ul>

  <a href="/life" class="back">← life</a>

</Life>

<style>
  .index {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
  }

  .index li { border-top: 1px solid var(--rule); }
  .index li:last-child { border-bottom: 1px solid var(--rule); }

  .index a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 18px 2px;
    text-decoration: none;
    color: var(--ink);
    transition: padding-left .22s ease;
  }
  .index a:hover { padding-left: 10px; }

  .i-title { font-size: 21px; }
  .index a:hover .i-title { color: var(--accent); }

  .i-form {
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    color: var(--ink-faint);
  }

  .back {
    display: inline-block;
    margin-top: 52px;
    font-size: 15px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }
</style>
