---
import Mark from '../components/Mark.astro';
import { FAVICON } from '../consts';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = 'Writing, books, and the things that are not projects.', canonical } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, 'https://kanishksigar.me').href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="author" content="Kanishk Sigar" />

  <link rel="icon" href={FAVICON} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />

  <link rel="alternate" type="application/rss+xml" title="Kanishk Sigar" href="/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet" />
</head>
<body>

  <a href="/" class="mark" aria-label="Home">
    <Mark size={18} />
  </a>

  <main>
    <slot />
  </main>

  <footer>
    <a href="/tech">tech</a>
    <a href="https://kanishksigar.substack.com" target="_blank" rel="noopener">substack</a>
    <a href="mailto:kanishksigar@gmail.com">email</a>
  </footer>

</body>
</html>

<style is:global>
  :root {
    --paper: #E9E7DE;
    --ink: #1A1C17;
    --ink-soft: #565A4E;
    --ink-faint: #85897B;
    --rule: #CFCCC0;
    --accent: #4F6B3E;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #12140F;
      --ink: #E4E3DA;
      --ink-soft: #9C9E92;
      --ink-faint: #6C6F63;
      --rule: #2A2E25;
      --accent: #8AA36F;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Spectral', Georgia, 'Times New Roman', serif;
    font-weight: 300;
    font-size: 19px;
    line-height: 1.72;
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    padding: 0 24px;
  }

  main {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    padding: 116px 0 96px;
    flex: 1;
  }

  p { margin: 0 0 1.35em; }

  a { color: var(--ink); text-decoration-color: var(--rule); text-underline-offset: 3px; }
  a:hover { text-decoration-color: var(--accent); }

  /* corner mark, the only thing shared with /tech */
  .mark {
    position: absolute;
    top: 32px;
    left: 32px;
    color: var(--ink-faint);
    line-height: 0;
    transition: color .2s ease;
  }
  .mark:hover { color: var(--accent); }

  footer {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    padding: 28px 0 44px;
    border-top: 1px solid var(--rule);
    display: flex;
    gap: 22px;
  }

  footer a {
    font-size: 15px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  footer a:hover { color: var(--ink); }

  @media (max-width: 640px) {
    body { font-size: 18px; }
    main { padding: 88px 0 72px; }
    .mark { top: 24px; left: 24px; }
  }
</style>
