---
import Mark from '../components/Mark.astro';
import { FAVICON_LIFE } from '../consts';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = 'Writing, books, and the things that are not projects.', canonical } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, 'https://kanishksigar.me').href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#E9E7DE" />

  <link rel="icon" href={FAVICON_LIFE} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />

  <link rel="alternate" type="application/rss+xml" title="Kanishk Sigar" href="/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet" />
</head>
<body>

  <header class="masthead">
    <a href="/" class="mark" aria-label="Home">
      <Mark size={17} />
    </a>
    <a href="/life" class="masthead-name">Kanishk Sigar</a>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <span class="colophon">set in Spectral</span>
    <nav>
      <a href="/tech">tech</a>
      <a href="https://kanishksigar.substack.com" target="_blank" rel="noopener">substack</a>
      <a href="mailto:kanishksigar@gmail.com">email</a>
    </nav>
  </footer>

</body>
</html>

<style is:global>
  :root {
    --paper: #E9E7DE;
    --ink: #1A1C17;
    --ink-soft: #565A4E;
    --ink-faint: #85897B;
    --rule: #CFCCC0;
    --accent: #4F6B3E;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #12140F;
      --ink: #E4E3DA;
      --ink-soft: #9C9E92;
      --ink-faint: #6C6F63;
      --rule: #2A2E25;
      --accent: #8AA36F;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Spectral', Georgia, 'Times New Roman', serif;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.78;
    -webkit-font-smoothing: antialiased;
    display: flex;
    flex-direction: column;
    padding: 0 24px;
  }

  /* ---- masthead ---- */
  .masthead {
    width: 100%;
    max-width: 33rem;
    margin: 0 auto;
    padding: 44px 0 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mark { color: var(--ink-faint); line-height: 0; transition: color .2s ease; }
  .mark:hover { color: var(--accent); }

  .masthead-name {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color .2s ease;
  }
  .masthead-name:hover { color: var(--ink); }

  /* ---- the page ---- */
  main {
    width: 100%;
    max-width: 33rem;
    margin: 0 auto;
    padding: 92px 0 110px;
    flex: 1;
  }

  main p { margin: 0 0 1.5em; }

  /* the opening line of a page carries the weight */
  main > p:first-child {
    font-size: 25px;
    line-height: 1.55;
    margin-bottom: 1.1em;
  }

  main a { color: var(--ink); text-decoration-color: var(--rule); text-underline-offset: 4px; }
  main a:hover { text-decoration-color: var(--accent); }

  main em { font-style: italic; }

  /* ---- foot ---- */
  footer {
    width: 100%;
    max-width: 33rem;
    margin: 0 auto;
    padding: 26px 0 48px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
  }

  .colophon {
    font-size: 14px;
    font-style: italic;
    color: var(--ink-faint);
  }

  footer nav { display: flex; gap: 20px; }

  footer a {
    font-size: 15px;
    color: var(--ink-faint);
    text-decoration: none;
  }
  footer a:hover { color: var(--ink); }

  @media (max-width: 640px) {
    body { font-size: 19px; }
    main { padding: 68px 0 84px; }
    main > p:first-child { font-size: 22px; }
    .masthead { padding-top: 32px; }
  }
</style>
