---
import Mark from '../components/Mark.astro';
import { FAVICON_LIFE } from '../consts';
import '../styles/life.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  reading?: boolean;
}

const { title, description = 'Writing, books, and the things that are not projects.', canonical, reading = false } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, 'https://kanishksigar.me').href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#f8f5ed" />

  <link rel="icon" href={FAVICON_LIFE} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />

  <link rel="alternate" type="application/rss+xml" title="Kanishk Sigar" href="/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="life-skip" href="#life-main">Skip to content</a>
  <header class="life-shell life-masthead">
    <a href="/life/" class="life-signature" aria-label="Kanishk Sigar, Life">
      <Mark size={27} />
      <span>Kanishk Sigar</span>
    </a>
    <nav aria-label="Life navigation">
      <a href="/life/writing/" aria-current={Astro.url.pathname.startsWith('/life/writing') ? 'page' : undefined}>writing</a>
      <a href="/life/shelf/" aria-current={Astro.url.pathname.startsWith('/life/shelf') ? 'page' : undefined}>the shelf</a>
      <a href="/tech/">tech</a>
    </nav>
  </header>

  <main id="life-main" class:list={['life-shell', 'life-main', { 'life-reading': reading }]}>
    <slot />
  </main>

  <footer class="life-shell life-footer">
    <a href="/life/">Kanishk Sigar</a>
    <nav aria-label="Elsewhere">
      <a href="/rss.xml">RSS</a>
      <a href="https://kanishksigar.substack.com" target="_blank" rel="noopener">Substack</a>
      <a href="mailto:kanishksigar@gmail.com">Email</a>
    </nav>
  </footer>
</body>
</html>
