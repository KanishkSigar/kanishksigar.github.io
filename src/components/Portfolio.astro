---
import Mark from './Mark.astro';
import { FAVICON_TECH } from '../consts';
import '../styles/portfolio.css';
const projects = [
  { name: 'LexMap', type: 'Live app', image: 'lexmap', alt: 'LexMap with a legal reasoning graph and judgment input side by side', detail: 'I built a browser-based judgment explorer that links claims and conclusions to their source passages.', action: 'Explore a judgment', url: '/lexmap/' },
  { name: 'CharterDesk', type: 'Local demo', image: 'charterdesk', alt: 'CharterDesk showing the changed terms between two fixture offers', detail: 'I built a shared workspace for maritime fixture offers, counters, and recap PDFs during my Integrated Maritime Exchange internship.', action: 'Run the Docker demo', url: 'https://github.com/KanishkSigar/CharterDesk#local-docker-demo' },
  { name: 'SHADE', type: 'Research site', image: 'shade', alt: 'ROC curves for classifiers evaluated on held-out attack families', detail: 'I evaluated how intrusion detectors generalize to unseen attack families and published the results and reproduction steps.', action: 'Explore the results', url: '/shade/' },
];
const projectIndex = [
  ['CaseHarbor', 'Live app', 'Role-based legal case management', 'https://caseharbor.onrender.com/'],
  ['LiveLy', 'Download', 'A typed language and bytecode VM written in C++', 'https://github.com/KanishkSigar/Lively/releases/latest'],
  ['ArgonVault', 'Browser demo', 'Client-side file encryption and decryption', '/argonvault/'],
  ['AuraPulse', 'Live app', 'Apple Health imports and training trends', '/aurapulse/'],
  ['GitPulse', 'Live app', 'GitHub profile reports and comparison', '/gitpulse/'],
  ['RepoPulse', 'Live app', 'Repository activity and maintainer metrics', '/repopulse/'],
  ['SHADE-IDS', 'Source', 'Streamlit dashboard and recorded-flow replay', 'https://github.com/KanishkSigar/shade-ids'],
  ['Liberty Drive', 'Source', 'Browser driving game built with Three.js', 'https://github.com/KanishkSigar/liberty-drive'],
  ['Arc Track', 'Source', 'Daily habit tracker and journal', 'https://github.com/KanishkSigar/arc-track'],
  ['PagePilot', 'Source', 'Browser extension for reading and video controls', 'https://github.com/KanishkSigar/pagepilot'],
  ['ThreatLens', 'Source', 'SwiftUI phishing detection client and API', 'https://github.com/KanishkSigar/threatlens'],
  ['PowerGuard IoT', 'Source', 'Energy monitoring and anomaly detection', 'https://github.com/KanishkSigar/powerguard-iot'],
];
const experience = [
  { id: 'ime', title: 'Full Stack Developer Intern', org: 'Integrated Maritime Exchange', date: 'Oct–Nov 2025', detail: 'Developed backend and API features for internal tools, including CharterDesk’s maritime negotiation workflow.' },
  { id: 'tbi', title: 'Operations Intern', org: 'TBI GEU', date: 'Jul 2025–Sep 2026', detail: 'Coordinated innovation and entrepreneurship programs, led student teams, and managed event logistics.' },
];
const community = [
  { title: 'Events Lead', org: 'IEEE Student Branch, GEHU', date: 'Aug 2025–Oct 2026', detail: 'Planned technical workshops and campus events and coordinated volunteers.' },
  { title: 'Content Cell Head', org: 'NSS GEHU', date: 'Jul 2025–May 2026', detail: 'Led documentation and communications for campus drives and outreach.' },
];
const credentials = [
  ['AWS AI Practitioner Learning Plan', 'AWS Training & Certification'],
  ['Developing Generative AI Solutions', 'AWS Training & Certification'],
  ['Developing Machine Learning Solutions', 'AWS Training & Certification'],
  ['A Practical Introduction to Cloud Computing', 'EC-Council'],
  ['Career Essentials in Cybersecurity', 'Microsoft & LinkedIn'],
  ['TCS iON Career Edge – Young Professional', 'TCS iON'],
  ['Introduction to Responsible AI', 'Google Cloud'],
  ['World Summit on Disaster Management 2025', 'Participant'],
];
const filters = [
  ['all', 'All'],
  ['try', 'Try online'],
  ['download', 'Download'],
  ['source', 'Source'],
];
const getCategory = (type: string) => type === 'Source' ? 'source' : type === 'Download' ? 'download' : 'try';

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanishk Sigar Tech</title>
  <meta name="description" content="Portfolio of Kanishk Sigar - Computer Science student and full-stack developer building useful software in Dehradun, India." />
  <link rel="canonical" href="https://kanishksigar.me/tech" />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#fafbf6" />

  <link rel="icon" href={FAVICON_TECH} />
  <link rel="apple-touch-icon" href={FAVICON_TECH} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kanishk Sigar" />
  <meta property="og:title" content="Kanishk Sigar - Student Developer" />
  <meta property="og:description" content="Computer science student and full-stack developer based in Dehradun, India." />
  <meta property="og:url" content="https://kanishksigar.me/tech" />
  <meta property="og:image" content="https://kanishksigar.me/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Kanishk Sigar - Student Developer" />
  <meta name="twitter:description" content="Computer science student and full-stack developer based in Dehradun, India." />
  <meta name="twitter:image" content="https://kanishksigar.me/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="shell site-nav" aria-label="Main navigation">
      <a class="site-mark" href="/" aria-label="Kanishk Sigar, home"><Mark size={32} /></a>
      <div class="nav-links">
        <a href="#works">Work</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </div>
      <a class="nav-resume" href="/profile.pdf">Résumé <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="main">
    <section class="shell hero" id="home" aria-labelledby="name">
      <div class="hero-copy">
        <p class="eyebrow location">Dehradun, India</p>
        <h1 id="name">Kanishk<br />Sigar<span>.</span></h1>
        <p class="hero-summary">Computer science student building web applications and tools for developers.</p>
        <div class="hero-actions">
          <a class="button button-accent" href="#works">Explore my work <span aria-hidden="true">↓</span></a>
          <a class="quiet-link" href="https://github.com/KanishkSigar">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="portrait">
        <img src="/projects/portrait.webp" alt="Kanishk Sigar" width="760" height="760" fetchpriority="high" />
        <figcaption><span class="availability-dot" aria-hidden="true"></span> Open to 2027 software engineering and research roles</figcaption>
      </figure>
    </section>

    <section class="shell work-section" id="works" aria-labelledby="work-title">
      <div class="section-heading">
        <h2 id="work-title">Selected work</h2>
        <a class="quiet-link" href="#project-index">Project index <span aria-hidden="true">↓</span></a>
      </div>
      <div class="project-grid">
        {projects.map(project => (
          <article class="project">
            <div class="project-media">
              <img src={`/projects/${project.image}.webp`} alt={project.alt} width="1200" height="750" loading="lazy" decoding="async" />
            </div>
            <div class="project-copy">
              <p class="eyebrow project-type">{project.type}</p>
              <h3>{project.name}</h3>
              <p>{project.detail}</p>
              <a class="project-action" href={project.url}>{project.action} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>

      <section class="project-index" id="project-index" aria-labelledby="index-title">
        <div class="section-heading">
          <h2 id="index-title">Project index</h2>
          <a class="quiet-link" href="https://github.com/KanishkSigar?tab=repositories">All repositories <span aria-hidden="true">↗</span></a>
        </div>
        <div class="filters" aria-label="Filter projects" hidden>
          {filters.map(([category, label]) => (
            <button type="button" data-filter={category} aria-pressed={category === 'all'}>{label}</button>
          ))}
        </div>
        <p id="filter-status" class="sr-only" role="status"></p>
        <ul class="project-list">
          {projectIndex.map(([name, type, summary, link]) => (
            <li data-category={getCategory(type)}>
              <a href={link}><strong>{name}</strong><span class="project-description">{summary}</span><span class="index-kind">{type} <span aria-hidden="true">↗</span></span></a>
            </li>
          ))}
        </ul>
      </section>
    </section>

    <div class="paper">
      <section class="shell background" id="about" aria-labelledby="about-title">
        <div>
          <h2 id="about-title">About</h2>
          <p>I’m finishing a B.Tech in Computer Science at Graphic Era Hill University, Dehradun (2023–2027). My recent work spans web software and security research.</p>
          <a class="quiet-link" href="/life/">Writing and life <span aria-hidden="true">↗</span></a>
        </div>
        <dl class="toolkit">
          <div><dt>Languages</dt><dd>TypeScript, Python, C++</dd></div>
          <div><dt>Web &amp; data</dt><dd>React, Node.js, FastAPI, PostgreSQL</dd></div>
          <div><dt>Infrastructure &amp; ML</dt><dd>Docker, AWS S3, PyTorch</dd></div>
        </dl>
      </section>

      <section class="shell history" id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <div class="history-list">
          {experience.map(role => (
            <article class="history-row" id={role.id}>
              <p class="history-date">{role.date}</p>
              <div><h3>{role.title}</h3><p class="history-org">{role.org}</p><p>{role.detail}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="shell history" id="leadership" aria-labelledby="leadership-title">
        <h2 id="leadership-title">Leadership</h2>
        <div class="history-list">
          {community.map(role => (
            <article class="history-row">
              <p class="history-date">{role.date}</p>
              <div><h3>{role.title}</h3><p class="history-org">{role.org}</p><p>{role.detail}</p></div>
            </article>
          ))}
        </div>
      </section>

      <div class="shell credential-wrap">
        <details class="credentials" id="certifications">
          <summary>Credentials and programs</summary>
          <ul>{credentials.map(([title, issuer]) => <li><strong>{title}</strong><span>{issuer}</span></li>)}</ul>
        </details>
      </div>
    </div>

    <section class="shell contact" id="contact" aria-labelledby="contact-title">
      <div>
        <h2 id="contact-title">Get in touch.</h2>
        <p>For software engineering roles, research, and project collaboration.</p>
      </div>
      <div>
        <a class="button button-accent email" href="mailto:kanishksigar@gmail.com">kanishksigar@gmail.com <span aria-hidden="true">↗</span></a>
        <div class="contact-links">
          <a class="quiet-link" href="https://www.linkedin.com/in/kanishk-sigar">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="quiet-link" href="https://github.com/KanishkSigar">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <footer class="shell footer">
    <span>© 2026 Kanishk Sigar</span>
    <a class="quiet-link" href="#home">Back to top <span aria-hidden="true">↑</span></a>
  </footer>
  <script>
    const index = document.querySelector('#project-index');
    const filters = index?.querySelector<HTMLElement>('.filters');
    const rows = index?.querySelectorAll<HTMLElement>('[data-category]');
    const status = document.querySelector('#filter-status');

    if (filters && rows && status) {
      filters.hidden = false;
      filters.addEventListener('click', event => {
        if (!(event.target instanceof HTMLButtonElement)) return;
        const category = event.target.dataset.filter;
        filters.querySelectorAll('button').forEach(button => {
          button.setAttribute('aria-pressed', String(button === event.target));
        });
        let visible = 0;
        rows.forEach(row => {
          row.hidden = category !== 'all' && row.dataset.category !== category;
          if (!row.hidden) visible++;
        });
        status.textContent = `${visible} projects shown.`;
      });
    }
  </script>
</body>
</html>
