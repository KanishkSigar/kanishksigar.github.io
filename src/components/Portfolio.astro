---
import Mark from './Mark.astro';
import { FAVICON_TECH, TEAL } from '../consts';
const projects = [
  { name: 'LexMap', type: 'Live app', image: 'lexmap', alt: 'LexMap with a legal reasoning graph and judgment input side by side', detail: 'I built a browser-based judgment explorer that links claims and conclusions to their source passages.', action: 'Explore a judgment', url: '/lexmap/' },
  { name: 'CharterDesk', type: 'Local demo', image: 'charterdesk', alt: 'CharterDesk showing the changed terms between two fixture offers', detail: 'I built a shared workspace for maritime fixture offers, counters, and recap PDFs during my Integrated Maritime Exchange internship.', action: 'Run the Docker demo', url: 'https://github.com/KanishkSigar/CharterDesk#local-docker-demo' },
  { name: 'SHADE', type: 'Research site', image: 'shade', alt: 'ROC curves for classifiers evaluated on held-out attack families', detail: 'I evaluated how intrusion detectors generalize to unseen attack families and published the results and reproduction steps.', action: 'Explore the results', url: '/shade/' },
];
const projectIndex = [
  ['CaseHarbor', 'Live app', 'Role-based legal case management', 'https://caseharbor.onrender.com/'],
  ['LiveLy', 'Download', 'A typed language and bytecode VM written in C++', 'https://github.com/KanishkSigar/Lively/releases/latest'],
  ['ArgonVault', 'Browser demo', 'Client-side file encryption and decryption', '/argonvault/'],
  ['AuraPulse', 'Live app', 'Apple Health imports and training trends', '/aurapulse/'],
  ['GitPulse', 'Live app', 'GitHub profile reports and comparison', '/gitpulse/'],
  ['RepoPulse', 'Live app', 'Repository activity and maintainer metrics', '/repopulse/'],
  ['SHADE-IDS', 'Source', 'Streamlit dashboard and recorded-flow replay', 'https://github.com/KanishkSigar/shade-ids'],
  ['Liberty Drive', 'Source', 'Browser driving game built with Three.js', 'https://github.com/KanishkSigar/liberty-drive'],
  ['Arc Track', 'Source', 'Daily habit tracker and journal', 'https://github.com/KanishkSigar/arc-track'],
  ['PagePilot', 'Source', 'Browser extension for reading and video controls', 'https://github.com/KanishkSigar/pagepilot'],
  ['ThreatLens', 'Source', 'SwiftUI phishing detection client and API', 'https://github.com/KanishkSigar/threatlens'],
  ['PowerGuard IoT', 'Source', 'Energy monitoring and anomaly detection', 'https://github.com/KanishkSigar/powerguard-iot'],
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanishk Sigar Tech</title>
  <meta name="description" content="Portfolio of Kanishk Sigar - Computer Science student and full-stack developer building useful software in Dehradun, India." />
  <link rel="canonical" href="https://kanishksigar.me/tech" />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#388087" />

  <link rel="icon" href={FAVICON_TECH} />
  <link rel="apple-touch-icon" href={FAVICON_TECH} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kanishk Sigar" />
  <meta property="og:title" content="Kanishk Sigar - Student Developer" />
  <meta property="og:description" content="CS undergrad and full-stack developer building full-stack apps, AI tools, and the occasional compiler. Based in Dehradun, India." />
  <meta property="og:url" content="https://kanishksigar.me/tech" />
  <meta property="og:image" content="https://kanishksigar.me/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Kanishk Sigar - Student Developer" />
  <meta name="twitter:description" content="CS undergrad and full-stack developer building full-stack apps, AI tools, and the occasional compiler. Based in Dehradun, India." />
  <meta name="twitter:image" content="https://kanishksigar.me/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <nav id="navbar" class="navbar">
    <div class="nav-left">
      <a href="#home" class="nav-link">Home</a>
      <a href="#about" class="nav-link">About</a>
    </div>
    <a href="/" class="nav-logo" aria-label="Home">
      <div class="logo-mark">
        <Mark size={26} color={TEAL} />
      </div>
    </a>
    <div class="nav-right">
      <a href="#works" class="nav-link">Works</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>
  </nav>

  <!-- Mobile Nav -->
  <div class="mobile-nav">
    <div class="mobile-nav-inner">
      <Mark size={26} color={TEAL} />
      <button class="hamburger" id="hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <a href="#home" class="mobile-link">Home</a>
      <a href="#about" class="mobile-link">About</a>
      <a href="#works" class="mobile-link">Works</a>
      <a href="#contact" class="mobile-link">Contact</a>
    </div>
  </div>

  <!-- ===== HERO ===== -->
  <section id="home" class="hero">
    <h1 class="hero-name">Kanishk Sigar</h1>
    <div class="hero-lower">
      <div class="hero-lower-text">
        <p class="hero-line">Building products for the web and beyond.</p>
        <p class="hero-bio">Final-year Computer Science student working across compilers, explainable AI, and full-stack software engineering.</p>
      </div>
      <div class="hero-cta-row">
        <a href="#contact" class="hero-cta" id="hero-cta">
          Get In Touch
          <span class="cta-arrow">→</span>
        </a>
        <a href="/profile.pdf" target="_blank" rel="noopener" class="hero-cta-ghost" id="resume-cta">
          Download Resume
          <span class="ghost-arrow">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== NOW RULE ===== -->
  <section class="now-strip" aria-label="Currently working on">
    <div class="now-inner">
      <span class="now-label">Now</span>
      <span class="now-divider">/</span>
      <span class="now-item">Final-year CSE @ Graphic Era Hill University</span>
      <span class="now-dot">·</span>
      <span class="now-item">Open to 2027 SWE &amp; Research opportunities</span>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="section-wrap">
    <div class="about-grid">
      <div class="about-left-col">
        <div class="about-img-wrap">
          <img class="about-photo" src="/profile.png" alt="Kanishk Sigar" width="400" height="500" loading="lazy" />
        </div>
        <div class="about-credential">
          <span class="about-credential-icon">🎓</span>
          <div>
            <div class="about-credential-title">B.Tech CSE</div>
            <div class="about-credential-sub">Graphic Era Hill University</div>
          </div>
        </div>
      </div>
      <div class="about-text-col">
        <div class="section-tag">About Me</div>
        <h2 class="section-heading">Code, Build,<br/>Learn, Repeat.</h2>
        <p class="about-text" style="margin-top:20px;">
          I’m a CS undergrad at Graphic Era Hill University, Dehradun
          (2023-2027), building full-stack applications, experimenting
          with AI-powered tools, and exploring software engineering beyond
          the surface.
        </p>
        <p class="about-text">
          My interests span web development, cybersecurity, cloud technologies, 
          and creating projects that solve real problems through clean, 
          thoughtful engineering.
        </p>
        <p class="about-text">
          Outside the IDE, I write technical documentation, create
          content for student communities, and explore ideas at the
          intersection of technology and creativity.
        </p>
        <p class="about-tagline">Always learning. Always building.</p>
        <div class="skills-grid">
          <span class="skill-tag">TypeScript</span>
          <span class="skill-tag">Python</span>
          <span class="skill-tag">C++</span>
          <span class="skill-tag">PyTorch</span>
          <span class="skill-tag">React</span>
          <span class="skill-tag">Next.js</span>
          <span class="skill-tag">FastAPI</span>
          <span class="skill-tag">Node.js</span>
          <span class="skill-tag">PostgreSQL</span>
          <span class="skill-tag">AWS S3</span>
          <span class="skill-tag">Docker</span>
          <span class="skill-tag">Cybersecurity</span>
          <span class="skill-tag">Git</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS ===== -->
  <section class="stats-section" aria-label="At a glance">
    <div class="stats-grid">
      <a href="#works" class="stat-card" aria-label="View projects">
        <span class="stat-num">12+</span>
        <span class="stat-label">Active Projects</span>
        <span class="stat-sub">Compilers · AI · Web · 3D</span>
      </a>
      <div class="stat-card">
        <span class="stat-num">6+</span>
        <span class="stat-label">Languages</span>
        <span class="stat-sub">JS · TS · Python · Java · C++ · C</span>
      </div>
      <a href="#certifications" class="stat-card" aria-label="View certifications">
        <span class="stat-num">8+</span>
        <span class="stat-label">Certifications</span>
        <span class="stat-sub">AWS · Cloud · AI · Security</span>
      </a>
    </div>
  </section>

  <!-- ===== WORKS ===== -->
  <section id="works" class="works-section" aria-labelledby="works-title">
    <div class="section-header-row">
      <h2 class="section-heading" id="works-title">Selected work</h2>
      <a class="btn-outline" href="#project-index">Browse all projects ↓</a>
    </div>
    <div class="case-study-list">
      {projects.map((project) => (
        <article class="case-study" data-project={project.image}>
          <div class="case-study-copy">
            <p class="project-kind">{project.type}</p>
            <h3>{project.name}</h3>
            <p>{project.detail}</p>
            <a class="case-study-action" href={project.url}>{project.action} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="case-study-image">
            <img src={`/projects/${project.image}.webp`} alt={project.alt} width="1200" height="750" loading="lazy" decoding="async" />
          </div>
        </article>
      ))}
    </div>
    <div class="project-index" id="project-index">
      <div class="section-header-row">
        <h3>Project index</h3>
        <a href="https://github.com/KanishkSigar?tab=repositories">All GitHub repositories ↗</a>
      </div>
      <ul>
        {projectIndex.map(([name, type, summary, link]) => (
          <li><a href={link}><strong>{name}</strong><span>{summary}</span><span class="project-kind">{type} <span aria-hidden="true">↗</span></span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== PROFESSIONAL EXPERIENCE ===== -->
  <section id="experience" class="section-wrap">
    <div class="section-tag">Where I've Worked</div>
    <h2 class="section-heading">Professional Experience</h2>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-date">Oct 2025 - Nov 2025</div>
        <h3 class="timeline-title">Full Stack Developer Intern</h3>
        <p class="timeline-org">Integrated Maritime Exchange (IME) · Dehradun</p>
        <p class="timeline-desc">Worked on API-based and backend features for internal tools. Supported data workflows and simple AI-assisted modules, and collaborated with the team on integrations and updates.</p>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-date">Jul 2025 - Present</div>
        <h3 class="timeline-title">Operations Intern</h3>
        <p class="timeline-org">TBI GEU · Dehradun</p>
        <p class="timeline-desc">Supporting the execution of major innovation and entrepreneurship programs through clear planning and structured coordination. Leading student teams during events and managing on-ground flow, movement, and transitions.</p>
      </div>
    </div>
  </section>

  <!-- ===== LEADERSHIP & COMMUNITY ===== -->
  <section id="leadership" class="leadership-section">
    <div class="section-wrap">
      <div class="section-tag">Beyond the Code</div>
      <h2 class="section-heading">Leadership &amp; Community</h2>
      <div class="leadership-grid">
        <div class="role-card">
          <div class="role-icon">⚡</div>
          <div class="role-date">Aug 2025 - Present</div>
          <h3 class="role-title">Events Lead</h3>
          <p class="role-org">IEEE Student Branch, GEHU</p>
          <p class="role-desc">Planning and executing IEEE workshops, technical sessions, and large-scale campus events. Directing volunteer operations across multiple programs.</p>
        </div>
        <div class="role-card">
          <div class="role-icon">✎</div>
          <div class="role-date">Jul 2025 - May 2026</div>
          <h3 class="role-title">Content Cell Head</h3>
          <p class="role-org">NSS GEHU</p>
          <p class="role-desc">Heading the Content Cell - creating structured documentation for drives, events, and outreach. Keeping teams aligned through clear information flow.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CERTIFICATIONS ===== -->
  <section id="certifications" class="certs-section">
    <div class="section-wrap">
      <div class="section-tag">Credentials</div>
      <h2 class="section-heading">Certifications</h2>
      <div class="certs-grid">
        <div class="cert-card">
          <div class="cert-icon">🧠</div>
          <div class="cert-body">
            <div class="cert-title">AWS AI Practitioner Learning Plan</div>
            <div class="cert-issuer">AWS Training &amp; Certification</div>
          </div>
        </div>
        <div class="cert-card">
          <div class="cert-icon">✨</div>
          <div class="cert-body">
            <div class="cert-title">Developing Generative AI Solutions</div>
            <div class="cert-issuer">AWS Training &amp; Certification</div>
          </div>
        </div>
        <div class="cert-card">
          <div class="cert-icon">📊</div>
          <div class="cert-body">
            <div class="cert-title">Developing Machine Learning Solutions</div>
            <div class="cert-issuer">AWS Training &amp; Certification</div>
          </div>
        </div>
        <div class="cert-card">
          <div class="cert-icon">☁️</div>
          <div class="cert-body">
            <div class="cert-title">A Practical Introduction to Cloud Computing</div>
            <div class="cert-issuer">EC-Council</div>
          </div>
        </div>
        <div class="cert-card">
          <div class="cert-icon">🛡</div>
          <div class="cert-body">
            <div class="cert-title">Career Essentials in Cybersecurity</div>
            <div class="cert-issuer">Microsoft &amp; LinkedIn</div>
          </div>
        </div>
        <div class="cert-card">
          <div class="cert-icon">🎓</div>
          <div class="cert-body">
            <div class="cert-title">TCS iON Career Edge - Young Professional</div>
            <div class="cert-issuer">TCS iON</div>
          </div>
        </div>
        <div class="cert-card">
          <div class="cert-icon">🤖</div>
          <div class="cert-body">
            <div class="cert-title">Introduction to Responsible AI</div>
            <div class="cert-issuer">Google Cloud</div>
          </div>
        </div>
        <div class="cert-card">
          <div class="cert-icon">🌐</div>
          <div class="cert-body">
            <div class="cert-title">World Summit on Disaster Management 2025</div>
            <div class="cert-issuer">Participant</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TOOLS ===== -->
  <section class="section-wrap" style="padding-top:90px;padding-bottom:90px">
    <div class="section-tag">Tools & Technologies</div>
    <div class="tools-grid">
      <div class="tool-card"><div class="tool-icon">⚛️</div><div class="tool-name">React / Next.js</div><div class="tool-level">Frontend</div></div>
      <div class="tool-card"><div class="tool-icon">📘</div><div class="tool-name">TypeScript</div><div class="tool-level">Web Systems</div></div>
      <div class="tool-card"><div class="tool-icon">🐍</div><div class="tool-name">Python</div><div class="tool-level">Core &amp; AI</div></div>
      <div class="tool-card"><div class="tool-icon">⚙️</div><div class="tool-name">C++</div><div class="tool-level">Systems &amp; VM</div></div>
      <div class="tool-card"><div class="tool-icon">🔥</div><div class="tool-name">PyTorch</div><div class="tool-level">Deep Learning</div></div>
      <div class="tool-card"><div class="tool-icon">⚡</div><div class="tool-name">FastAPI</div><div class="tool-level">Backend APIs</div></div>
      <div class="tool-card"><div class="tool-icon">🟢</div><div class="tool-name">Node.js</div><div class="tool-level">Runtime</div></div>
      <div class="tool-card"><div class="tool-icon">🐘</div><div class="tool-name">PostgreSQL</div><div class="tool-level">Databases</div></div>
      <div class="tool-card"><div class="tool-icon">☁️</div><div class="tool-name">AWS S3</div><div class="tool-level">Cloud Storage</div></div>
      <div class="tool-card"><div class="tool-icon">🐳</div><div class="tool-name">Docker</div><div class="tool-level">Containers</div></div>
      <div class="tool-card"><div class="tool-icon">🎮</div><div class="tool-name">Three.js</div><div class="tool-level">3D Graphics</div></div>
      <div class="tool-card"><div class="tool-icon">🌿</div><div class="tool-name">Git</div><div class="tool-level">Version Control</div></div>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section id="contact" class="contact-section">
    <div class="contact-card">
      <div class="section-tag">Let's Connect</div>
      <h2 class="contact-heading">Let's Build Something<br/>Together</h2>
      <p class="contact-sub">I'm open to internships, collaborative projects, and conversations about code, AI, or anything in between. Drop a line - I read everything.</p>
      <div class="contact-buttons">
        <a href="mailto:kanishksigar@gmail.com" class="btn-primary btn-large" id="email-btn">
          kanishksigar@gmail.com <span class="btn-arrow">→</span>
        </a>
        <div class="social-links">
          <a href="https://www.linkedin.com/in/kanishk-sigar" target="_blank" rel="noopener" class="social-link" id="linkedin-link">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn
          </a>
          <a href="https://github.com/KanishkSigar" target="_blank" rel="noopener" class="social-link" id="github-link">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <Mark size={22} color={TEAL} />
        <span class="footer-name">Kanishk Sigar</span>
      </div>
      <div class="footer-copy">© 2026 Kanishk Sigar. Code · Build · Learn · Repeat.</div>
    </div>
  </footer>

  <script is:inline src="/script.js"></script>
</body>
</html>