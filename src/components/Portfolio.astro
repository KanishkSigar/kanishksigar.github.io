---
import Mark from './Mark.astro';
import { FAVICON_TECH, TEAL } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kanishk Sigar Tech</title>
  <meta name="description" content="Portfolio of Kanishk Sigar - Computer Science student and full-stack developer building useful software in Dehradun, India." />
  <link rel="canonical" href="https://kanishksigar.me/tech" />
  <meta name="author" content="Kanishk Sigar" />
  <meta name="theme-color" content="#388087" />

  <link rel="icon" href={FAVICON_TECH} />
  <link rel="apple-touch-icon" href={FAVICON_TECH} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kanishk Sigar" />
  <meta property="og:title" content="Kanishk Sigar - Student Developer" />
  <meta property="og:description" content="CS undergrad and full-stack developer building full-stack apps, AI tools, and the occasional compiler. Based in Dehradun, India." />
  <meta property="og:url" content="https://kanishksigar.me/tech" />
  <meta property="og:image" content="https://kanishksigar.me/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Kanishk Sigar - Student Developer" />
  <meta name="twitter:description" content="CS undergrad and full-stack developer building full-stack apps, AI tools, and the occasional compiler. Based in Dehradun, India." />
  <meta name="twitter:image" content="https://kanishksigar.me/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <nav id="navbar" class="navbar">
    <div class="nav-left">
      <a href="#home" class="nav-link">Home</a>
      <a href="#about" class="nav-link">About</a>
    </div>
    <a href="/" class="nav-logo" aria-label="Home">
      <div class="logo-mark">
        <Mark size={26} color={TEAL} />
      </div>
    </a>
    <div class="nav-right">
      <a href="#works" class="nav-link">Works</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>
  </nav>

  <!-- Mobile Nav -->
  <div class="mobile-nav">
    <div class="mobile-nav-inner">
      <Mark size={26} color={TEAL} />
      <button class="hamburger" id="hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <a href="#home" class="mobile-link">Home</a>
      <a href="#about" class="mobile-link">About</a>
      <a href="#works" class="mobile-link">Works</a>
      <a href="#contact" class="mobile-link">Contact</a>
    </div>
  </div>

  <!-- ===== HERO ===== -->
  <section id="home" class="hero">
    <h1 class="hero-name">Kanishk Sigar</h1>
    <div class="hero-lower">
      <div class="hero-lower-text">
        <p class="hero-line">Building products for the web and beyond.</p>
        <p class="hero-bio">Final-year Computer Science student working across compilers, explainable AI, and full-stack software engineering.</p>
      </div>
      <div class="hero-cta-row">
        <a href="#contact" class="hero-cta" id="hero-cta">
          Get In Touch
          <span class="cta-arrow">→</span>
        </a>
        <a href="/profile.pdf" target="_blank" rel="noopener" class="hero-cta-ghost" id="resume-cta">
          Download Resume
          <span class="ghost-arrow">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== NOW RULE ===== -->
  <section class="now-strip" aria-label="Currently working on">
    <div class="now-inner">
      <span class="now-label">Now</span>
      <span class="now-divider">/</span>
      <span class="now-item">Final-year CSE @ Graphic Era Hill University</span>
      <span class="now-dot">·</span>
      <span class="now-item">Open to 2027 SWE &amp; Research opportunities</span>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="section-wrap">
    <div class="about-grid">
      <div class="about-left-col">
        <div class="about-img-wrap">
          <img class="about-photo" src="/profile.png" alt="Kanishk Sigar" width="400" height="500" loading="lazy" />
        </div>
        <div class="about-credential">
          <span class="about-credential-icon">🎓</span>
          <div>
            <div class="about-credential-title">B.Tech CSE</div>
            <div class="about-credential-sub">Graphic Era Hill University</div>
          </div>
        </div>
      </div>
      <div class="about-text-col">
        <div class="section-tag">About Me</div>
        <h2 class="section-heading">Code, Build,<br/>Learn, Repeat.</h2>
        <p class="about-text" style="margin-top:20px;">
          I’m a CS undergrad at Graphic Era Hill University, Dehradun
          (2023-2027), building full-stack applications, experimenting
          with AI-powered tools, and exploring software engineering beyond
          the surface.
        </p>
        <p class="about-text">
          My interests span web development, cybersecurity, cloud technologies, 
          and creating projects that solve real problems through clean, 
          thoughtful engineering.
        </p>
        <p class="about-text">
          Outside the IDE, I write technical documentation, create
          content for student communities, and explore ideas at the
          intersection of technology and creativity.
        </p>
        <p class="about-tagline">Always learning. Always building.</p>
        <div class="skills-grid">
          <span class="skill-tag">TypeScript</span>
          <span class="skill-tag">Python</span>
          <span class="skill-tag">C++</span>
          <span class="skill-tag">PyTorch</span>
          <span class="skill-tag">React</span>
          <span class="skill-tag">Next.js</span>
          <span class="skill-tag">FastAPI</span>
          <span class="skill-tag">Node.js</span>
          <span class="skill-tag">PostgreSQL</span>
          <span class="skill-tag">AWS S3</span>
          <span class="skill-tag">Docker</span>
          <span class="skill-tag">Cybersecurity</span>
          <span class="skill-tag">Git</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS ===== -->
  <section class="stats-section" aria-label="At a glance">
    <div class="stats-grid">
      <a href="#works" class="stat-card" aria-label="View projects">
        <span class="stat-num">12+</span>
        <span class="stat-label">Active Projects</span>
        <span class="stat-sub">Compilers · AI · Web · 3D</span>
      </a>
      <div class="stat-card">
        <span class="stat-num">6+</span>
        <span class="stat-label">Languages</span>
        <span class="stat-sub">JS · TS · Python · Java · C++ · C</span>
      </div>
      <a href="#certifications" class="stat-card" aria-label="View certifications">
        <span class="stat-num">8+</span>
        <span class="stat-label">Certifications</span>
        <span class="stat-sub">AWS · Cloud · AI · Security</span>
      </a>
    </div>
  </section>

  <!-- ===== WORKS ===== -->
  <section id="works" class="works-section">
    <div class="section-header-row">
      <div>
        <div class="section-tag">Selected Works</div>
        <h2 class="section-heading">Things I've<br/>Been Building</h2>
      </div>
      <a href="https://github.com/KanishkSigar?tab=repositories" target="_blank" rel="noopener" class="btn-outline">All Projects →</a>
    </div>
    <div class="works-grid">

      <article class="project-card project-card--light" id="project-1">
        <div class="project-card-inner">
          <div class="project-meta">
            <span class="project-num project-num--dark">01</span>
            <span class="project-tag project-tag--dark">PyTorch · SHAP · Explainable AI</span>
          </div>
          <div>
            <h3 class="project-title project-title--dark">SHADE</h3>
            <p class="project-desc project-desc--dark">An explainable hybrid intrusion detection system. Evaluates zero-day generalization via a leave-one-family-out protocol on UNSW-NB15 and CIC-IDS2017 using a label-free PyTorch autoencoder and supervised baselines, with SHAP attributions explaining every alert.</p>
          </div>
          <div class="project-visual shap-visual">
            <div class="shap-mockup">
              <div class="shap-header">
                <span class="shap-title">SHAP Feature Attribution · Anomaly Alert</span>
                <span class="shap-badge">Loss: 0.042 (High)</span>
              </div>
              <div class="shap-bars">
                <div class="shap-row">
                  <span class="shap-feat">sttl</span>
                  <div class="shap-bar-track"><div class="shap-bar-fill" style="width:85%"></div></div>
                  <span class="shap-val">+0.48</span>
                </div>
                <div class="shap-row">
                  <span class="shap-feat">ct_dst_src_ltm</span>
                  <div class="shap-bar-track"><div class="shap-bar-fill" style="width:68%"></div></div>
                  <span class="shap-val">+0.36</span>
                </div>
                <div class="shap-row">
                  <span class="shap-feat">sbytes</span>
                  <div class="shap-bar-track"><div class="shap-bar-fill shap-bar-alt" style="width:52%"></div></div>
                  <span class="shap-val">+0.22</span>
                </div>
                <div class="shap-row">
                  <span class="shap-feat">dur</span>
                  <div class="shap-bar-track"><div class="shap-bar-fill shap-bar-mint" style="width:34%"></div></div>
                  <span class="shap-val">-0.14</span>
                </div>
              </div>
            </div>
          </div>
          <div class="project-footer">
            <a href="https://kanishksigar.github.io/shade/" target="_blank" rel="noopener" class="project-link project-link--light">View Live →</a>
            <a href="https://github.com/KanishkSigar/shade" target="_blank" rel="noopener" class="project-link project-link--light">View on GitHub →</a>
          </div>
        </div>
      </article>

      <article class="project-card project-card--dark" id="project-2">
        <div class="project-card-inner">
          <div class="project-meta">
            <span class="project-num">02</span>
            <span class="project-tag">C++ · Compilers · Virtual Machine</span>
          </div>
          <div>
            <h3 class="project-title">Lively</h3>
            <p class="project-desc">A statically typed procedural language built from scratch — lexer, recursive-descent parser, three-address code (TAC) intermediate representation, bytecode compiler, and a stack-based virtual machine.</p>
          </div>
          <div class="project-visual lively-visual">
            <div class="code-block">
              <div class="code-line"><span class="kw">fn</span> <span class="fn">fib</span>(n: <span class="ty">int</span>) -&gt; <span class="ty">int</span> &#123;</div>
              <div class="code-line">&nbsp;&nbsp;<span class="kw">if</span> n &lt; 2 &#123; <span class="kw">return</span> n; &#125;</div>
              <div class="code-line">&nbsp;&nbsp;<span class="kw">return</span> <span class="fn">fib</span>(n-1) + <span class="fn">fib</span>(n-2);</div>
              <div class="code-line">&#125;</div>
              <div class="code-line"><span class="cm">// → TAC IR → bytecode generator → stack VM</span></div>
            </div>
          </div>
          <div class="project-footer">
            <a href="https://github.com/KanishkSigar/Lively" target="_blank" rel="noopener" class="project-link">View on GitHub →</a>
          </div>
        </div>
      </article>

      <article class="project-card project-card--dark" id="project-3">
        <div class="project-card-inner">
          <div class="project-meta">
            <span class="project-num">03</span>
            <span class="project-tag">FastAPI · Next.js · AWS · Cryptography</span>
          </div>
          <div>
            <h3 class="project-title">ArgonVault</h3>
            <p class="project-desc">A zero-knowledge encrypted file vault. Argon2id derives keys in the browser; AES-256-GCM encrypts files before they leave; ciphertext goes to S3 via presigned URLs. The server cannot read your files, filenames, or password.</p>
          </div>
          <div class="project-visual code-visual">
            <div class="terminal-mockup">
              <div class="terminal-bar">
                <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
                <span class="terminal-title">argonvault - bash</span>
              </div>
              <div class="terminal-body">
                <div class="term-line"><span class="term-prompt">$</span> argonvault auth derive</div>
                <div class="term-line term-ok">→ argon2id(64MiB, 3, 1) ✓</div>
                <div class="term-line"><span class="term-prompt">$</span> argonvault encrypt ./file.pdf</div>
                <div class="term-line term-ok">→ AES-256-GCM ✓ PUT → s3://… 200</div>
              </div>
            </div>
          </div>
          <div class="project-footer">
            <a href="https://kanishksigar.me/argonvault/" target="_blank" rel="noopener" class="project-link">View Live →</a>
            <a href="https://github.com/KanishkSigar/argonvault" target="_blank" rel="noopener" class="project-link">View on GitHub →</a>
          </div>
        </div>
      </article>

      <article class="project-card project-card--light" id="project-4">
        <div class="project-card-inner">
          <div class="project-meta">
            <span class="project-num project-num--dark">04</span>
            <span class="project-tag project-tag--dark">React 18 · Vite · HTML5 Canvas · Apple Health</span>
          </div>
          <div>
            <h3 class="project-title project-title--dark">AuraPulse</h3>
            <p class="project-desc project-desc--dark">A privacy-first health and biometrics platform for Apple Watch users. Parses native Apple Health XML/JSON exports in the browser to compute clinical sports science telemetry — real-time cardiac waveforms, HRV spectral power, and circadian rhythm models.</p>
          </div>
          <div class="project-visual ecg-visual">
            <div class="ecg-mockup">
              <div class="ecg-header">
                <span class="ecg-status"><span class="ecg-pulse-dot"></span> Telemetry Active</span>
                <div class="ecg-badges">
                  <span class="ecg-pill">HRV 68ms</span>
                  <span class="ecg-pill ecg-pill--mint">Zone 2</span>
                </div>
              </div>
              <svg class="ecg-line" viewBox="0 0 300 70" preserveAspectRatio="none">
                <path d="M0,35 L40,35 L50,35 L55,20 L60,50 L65,10 L72,60 L78,35 L90,35 L120,35 L125,25 L130,45 L135,15 L142,58 L148,35 L160,35 L190,35 L195,22 L200,48 L205,12 L212,62 L218,35 L230,35 L260,35 L265,24 L270,46 L275,14 L282,59 L288,35 L300,35" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div class="ecg-footer">
                <span class="ecg-stat"><strong>74</strong> BPM</span>
                <span class="ecg-stat"><strong>98%</strong> SpO2</span>
                <span class="ecg-stat"><strong>4.2</strong> SRI</span>
              </div>
            </div>
          </div>
          <div class="project-footer">
            <a href="https://kanishksigar.me/aurapulse/" target="_blank" rel="noopener" class="project-link project-link--light">View Live →</a>
            <a href="https://github.com/KanishkSigar/AuraPulse" target="_blank" rel="noopener" class="project-link project-link--light">View on GitHub →</a>
          </div>
        </div>
      </article>

      <article class="project-card project-card--light" id="project-5">
        <div class="project-card-inner">
          <div class="project-meta">
            <span class="project-num project-num--dark">05</span>
            <span class="project-tag project-tag--dark">TypeScript · React · LegalTech</span>
          </div>
          <div>
            <h3 class="project-title project-title--dark">LexMap</h3>
            <p class="project-desc project-desc--dark">Converts unstructured legal judgment text into an interactive reasoning graph with an AI legal assistant — making complex case logic, holdings, and precedents navigable and traceable.</p>
          </div>
          <div class="project-visual graph-visual">
            <div class="graph-mockup">
              <span class="node node-a">Facts</span>
              <span class="node node-b">Issue</span>
              <span class="node node-c">Rule</span>
              <span class="node node-d">Holding</span>
              <svg class="graph-lines" viewBox="0 0 200 120" preserveAspectRatio="none">
                <line x1="30" y1="30" x2="100" y2="30" />
                <line x1="100" y1="30" x2="100" y2="90" />
                <line x1="100" y1="90" x2="170" y2="90" />
                <line x1="30" y1="30" x2="170" y2="90" />
              </svg>
            </div>
          </div>
          <div class="project-footer">
            <a href="https://kanishksigar.me/lexmap/" target="_blank" rel="noopener" class="project-link project-link--light">View Live →</a>
            <a href="https://github.com/KanishkSigar/lexmap" target="_blank" rel="noopener" class="project-link project-link--light">View on GitHub →</a>
          </div>
        </div>
      </article>

      <article class="project-card project-card--dark" id="project-6">
        <div class="project-card-inner">
          <div class="project-meta">
            <span class="project-num">06</span>
            <span class="project-tag">PHP · MySQL · Maritime Tech</span>
          </div>
          <div>
            <h3 class="project-title">CharterDesk</h3>
            <p class="project-desc">A structured charter-party negotiation and document-generation tool for maritime fixture deals, built during my internship at Integrated Maritime Exchange. Parties negotiate ~38 fixture terms in versioned offers, lock agreed clauses, and export finished recap PDFs.</p>
          </div>
          <div class="project-visual chat-visual">
            <div class="chat-mockup">
              <div class="chat-header">
                <span class="chat-avatar">⚓</span>
                <div>
                  <div class="chat-name">Fixture · MV Aurora</div>
                  <div class="chat-status"><span class="chat-dot"></span> Negotiating</div>
                </div>
              </div>
              <div class="chat-msg chat-msg--user">Owner: Freight USD 14.50/mt - firm offer</div>
              <div class="chat-msg chat-msg--bot">Charterer: Counter 13.75/mt, laycan 12-18 Jun</div>
              <div class="chat-input">Draft rider clause…</div>
            </div>
          </div>
          <div class="project-footer">
            <a href="https://github.com/KanishkSigar/CharterDesk" target="_blank" rel="noopener" class="project-link">View on GitHub →</a>
          </div>
        </div>
      </article>

    </div>

    <div class="also-built">
      <h3 class="also-heading">Also built &amp; explored</h3>
      <ul class="also-list">
        <li class="also-item">
          <a href="https://kanishksigar.me/gitpulse" target="_blank" rel="noopener">
